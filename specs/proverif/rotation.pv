(* The rotation that follows a removal, as specs/PROTOCOL.md describes it, against an attacker who holds every key of the removed device and the old epoch key, and who can forge Ed25519 signatures, as a quantum computer could.
   The rotating member wraps the new epoch key for each remaining member and seals its state under it.
   It checks that the attacker learns neither the new key nor the state, and that a remaining member installs only the rotation the rotating member signed. *)

free account: bitstring.
free epoch: bitstring.
free oldkey: key [private].
free newkey: key [private].
free state: bitstring [private].

event Rotated(key).
event Installed(key).
event Sealed(bitstring).
event Read(bitstring).

query attacker(newkey).
query attacker(state).
query k: key; event(Installed(k)) ==> event(Rotated(k)).
query s: bitstring; event(Read(s)) ==> event(Sealed(s)).

(* The slot of one member: the encapsulation to its key and the epoch key under the key that encapsulation yields. *)
letfun slot(member: kempk, r: seed) =
  (member, encapsulate(member, r), seal(keybits(newkey), slotkey(shared(member, r), (account, epoch, member)), account)).

let rotating(classical: signsk, quantum: signsk, remaining: kempk) =
  new r: seed;
  let operation = (account, epoch, slot(remaining, r)) in
  event Rotated(newkey);
  out(c, (operation, sign((operationLabel, operation), classical), sign((operationLabel, operation), quantum)));
  event Sealed(state);
  out(c, seal(state, newkey, (stateLabel, account, epoch, signpublic(quantum)))).

let remaining(sk: kemsk, classical: signpk, quantum: signpk) =
  in(c, (operation: bitstring, first: bitstring, second: bitstring));
  if verify(first, classical, (operationLabel, operation)) = true then
  if verify(second, quantum, (operationLabel, operation)) = true then
  let (=account, =epoch, (=kempublic(sk), encapsulation: bitstring, wrapped: bitstring)) = operation in
  let keybits(k: key) = unseal(wrapped, slotkey(decapsulate(encapsulation, sk), (account, epoch, kempublic(sk))), account) in
  event Installed(k);
  in(c, sealed: bitstring);
  let s = unseal(sealed, k, (stateLabel, account, epoch, quantum)) in
  event Read(s).

process
  new classical: signsk;
  new quantum: signsk;
  new member: kemsk;
  new removed: kemsk;
  out(c, (signpublic(classical), signpublic(quantum), kempublic(member), kempublic(removed)));
  (* The removed device is the attacker's, with the old epoch key it held, and Ed25519 is broken. *)
  out(c, (removed, oldkey, classical));
  (rotating(classical, quantum, kempublic(member)) | ! remaining(member, signpublic(classical), signpublic(quantum)))
