(* Recovery with a recovery key, as specs/PROTOCOL.md describes it.
   The attacker learned the recovery member's public keys while it was a member, answers for the relay's directory and every channel, founds accounts of its own, and can forge Ed25519 signatures.
   The founder of the honest account enrolls the key: the key's member signs its consent to the account, and a rotation the founder signs wraps the epoch key for that member.
   A device that recovers with the key takes an account from the attacker, joins it only when the key's member consented to it, unwraps the epoch key, and seals its later state under that key.
   The model checks that a recovering device joins only an account its key consented to, and that neither the epoch key nor the later state reaches the attacker.
   It lets only the founder rotate, which stands for the members that the account's log lists from its genesis on. *)

free epoch: bitstring.
free epochkey: key [private].
free later: bitstring [private].

event Consented(bitstring).
event Recovered(bitstring).

query a: bitstring; event(Recovered(a)) ==> event(Consented(a)).
query attacker(epochkey).
query attacker(later).

let founding(founder: signsk, quantum: signsk, member: signsk, memberquantum: signsk, memberkem: kempk) =
  let account = accountof(signpublic(founder), signpublic(quantum)) in
  new r: seed;
  let consent = (consentLabel, account) in
  event Consented(account);
  let rotation = (operationLabel, account, epoch, encapsulate(memberkem, r), seal(keybits(epochkey), slotkey(shared(memberkem, r), (account, epoch, memberkem)), account)) in
  out(c, (sign(consent, member), sign(consent, memberquantum), rotation, sign(rotation, founder), sign(rotation, quantum))).

let recovering(member: signpk, memberquantum: signpk, memberkem: kemsk) =
  in(c, (founder: signpk, quantum: signpk, consented: bitstring, consentedquantum: bitstring, rotation: bitstring, signed: bitstring, signedquantum: bitstring));
  let account = accountof(founder, quantum) in
  if verify(consented, member, (consentLabel, account)) = true then
  if verify(consentedquantum, memberquantum, (consentLabel, account)) = true then
  if verify(signed, founder, rotation) = true then
  if verify(signedquantum, quantum, rotation) = true then
  let (=operationLabel, =account, =epoch, encapsulation: bitstring, wrapped: bitstring) = rotation in
  let keybits(k: key) = unseal(wrapped, slotkey(decapsulate(encapsulation, memberkem), (account, epoch, kempublic(memberkem))), account) in
  event Recovered(account);
  out(c, seal(later, k, (stateLabel, account, epoch))).

process
  new founder: signsk;
  new quantum: signsk;
  new member: signsk;
  new memberquantum: signsk;
  new memberkem: kemsk;
  out(c, (signpublic(founder), signpublic(quantum), signpublic(member), signpublic(memberquantum), kempublic(memberkem)));
  (* Ed25519 is broken, so the attacker holds the classical keys of the founder and of the key's member. *)
  out(c, (founder, member));
  (founding(founder, quantum, member, memberquantum, kempublic(memberkem)) | ! recovering(signpublic(member), signpublic(memberquantum), memberkem))
