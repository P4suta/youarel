{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "youarel",
  "version": "0.0.0",
  "identifier": "io.github.p4suta.youarel",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "library",
        "title": "youarel",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "visible": false,
        "focus": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 22 },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
