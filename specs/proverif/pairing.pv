(* The pairing of specs/PROTOCOL.md against an attacker who controls the channel but lacks the code.
   Any number of pairings run at once under one code, which grants the attacker more than one invitation does.
   It checks that the attacker cannot test the code offline, learns neither the epoch key nor the state of an entry, that a joiner confirms only a welcome the inviter sent, that the inviter adds only a joiner that confirmed, and that a joiner installs only an entry the inviter sealed for it. *)

free password: code [private].
free epochkey: key [private].
free state: bitstring [private].

event Welcomed(kempk, bitstring).
event Confirmed(kempk, bitstring).
event Added(kempk, bitstring).
event Installed(kempk, bitstring).

weaksecret password.
query attacker(epochkey).
query attacker(state).
query joiner: kempk, transcript: bitstring; event(Confirmed(joiner, transcript)) ==> event(Welcomed(joiner, transcript)).
query joiner: kempk, transcript: bitstring; event(Added(joiner, transcript)) ==> event(Confirmed(joiner, transcript)).
query joiner: kempk, transcript: bitstring; event(Installed(joiner, transcript)) ==> event(Added(joiner, transcript)).

let joining(invitation: bitstring) =
  new sk: kemsk;
  new x: exponent;
  let share = blind(exp(g, x), password) in
  out(c, (invitation, kempublic(sk), share));
  in(c, (=invitation, answer: G, encapsulation: bitstring, welcomed: bitstring));
  let transcript = (invitation, kempublic(sk), share, answer, encapsulation) in
  let k = channelkey(pakekey(exp(unblind(answer, password), x), share, answer), decapsulate(encapsulation, sk), transcript) in
  if welcomed = mac(k, (welcomedLabel, transcript)) then
  event Confirmed(kempublic(sk), transcript);
  out(c, (invitation, mac(k, (joinedLabel, transcript))));
  in(c, (=invitation, sealed: bitstring));
  let (keybits(received: key), held: bitstring) = unseal(sealed, k, invitation) in
  event Installed(kempublic(sk), transcript).

let inviting(invitation: bitstring) =
  in(c, (=invitation, joiner: kempk, share: G));
  new y: exponent;
  new r: seed;
  let answer = blind(exp(g, y), password) in
  let encapsulation = encapsulate(joiner, r) in
  let transcript = (invitation, joiner, share, answer, encapsulation) in
  let k = channelkey(pakekey(exp(unblind(share, password), y), share, answer), shared(joiner, r), transcript) in
  event Welcomed(joiner, transcript);
  out(c, (invitation, answer, encapsulation, mac(k, (welcomedLabel, transcript))));
  in(c, (=invitation, joined: bitstring));
  if joined = mac(k, (joinedLabel, transcript)) then
  event Added(joiner, transcript);
  out(c, (invitation, seal((keybits(epochkey), state), k, invitation))).

process
  ! (new invitation: bitstring; out(c, invitation); (joining(invitation) | inviting(invitation)))
